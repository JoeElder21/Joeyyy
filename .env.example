# Schwab connector settings — copy to .env and fill in.
#
# .env is git-ignored. Never commit a filled-in copy of this file, and never
# paste these values into a chat, an issue, or a commit message.
#
# Both values come from developer.schwab.com after your app reaches
# "Ready For Use" status. See docs/SCHWAB_TRADING_AGENT.md.

# App Key from the developer portal (public client identifier).
SCHWAB_APP_KEY=

# App Secret from the developer portal. Treat as a password.
SCHWAB_APP_SECRET=

# Must match the callback registered in the portal byte for byte.
# Schwab only accepts 127.0.0.1 as the callback host.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Optional overrides. Defaults are shown.
# SCHWAB_TOKEN_PATH=secrets/schwab-token.json
# SCHWAB_POLICY_PATH=config/portfolio_policy.toml
# SCHWAB_REPORT_DIR=runtime-memory/portfolio
